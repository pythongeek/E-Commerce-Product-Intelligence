# ProductIntel - Environment Configuration
# Copy this file to .env and fill in your actual values

# App
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://app:devpassword@postgres:5432/product_intel
DATABASE_URL_SYNC=postgresql://app:devpassword@postgres:5432/product_intel

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=change-me-to-a-random-64-char-string-in-production

# MiniMax M2.7 AI
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_GROUP_ID=your-minimax-group-id

# Facebook Ad Library API
FB_ACCESS_TOKEN=your-fb-access-token
# Note: For production, use a token pool via admin API

# Scraping / Proxy (Bright Data)
BRIGHT_DATA_USER=your-brightdata-username
BRIGHT_DATA_PASS=your-brightdata-password

# Amazon PA API 5.0
AMAZON_PA_API_KEY=your-amazon-pa-api-key
AMAZON_PA_API_SECRET=your-amazon-pa-api-secret
AMAZON_ASSOCIATE_TAG=your-associate-tag-20

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Notifications
RESEND_API_KEY=re_...
FROM_EMAIL=alerts@productintel.io
